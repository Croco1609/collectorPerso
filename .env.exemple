# Modèle de configuration pour le dev local
# Copiez ce fichier, renommez-le en ".env" et remplacez les valeurs si besoin

PORT=3000
DB_USER=votre_utilisateur
DB_PASSWORD=votre_mot_de_passe
DB_HOST=localhost
DB_PORT=5432
DB_NAME=collector_db
DB_FORCE_RESTART=false

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# URL de Keycloak (utilisé par le backend)
KEYCLOAK_AUTH_URL=http://localhost:8080